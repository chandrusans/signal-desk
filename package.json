{
  "name": "signal-desk",
  "version": "2.4.0",
  "description": "Multi-user momentum-swing signals platform — Stocks, Options, Metals, Personal Dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "unpdf": "^1.7.0",
    "web-push": "^4.0.0"
  },
  "scripts": {
    "validate": "sh tools/validate.sh",
    "lint": "node tools/lint.mjs research.html today.html swing.html alerts.html simulate.html index.html dashboard.html options.html crypto.html metals.html handbook.html privacy.html terms.html",
    "validate:co": "sh tools/validate.sh co",
    "validate:risk": "node tools/validate-risk.mjs",
    "validate:research": "sh tools/validate.sh research",
    "test": "node --test test/",
    "screen:build": "node tools/build-screen.mjs",
    "replay": "node --max-old-space-size=6144 tools/replay.mjs",
    "earnings:build": "node tools/build-earnings.mjs",
    "health": "node tools/check-health.mjs",
    "e2e": "playwright test",
    "experiments": "node --max-old-space-size=6144 tools/experiments.mjs"
  },
  "overrides": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
